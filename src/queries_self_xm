# NON-EXECUTABLE OVERVIEW OF ADQL QUERIES USED IN THE GAIA ARCHIVE

# 1. Goal: Aggresively filter out low magnitude stars from Gaia to setup for XM
# Result: Gaia Lite data of 3,087,821 stars
# Comment: Saved as gaia_sel12

SELECT *
FROM gaiadr3.gaia_source_lite
WHERE phot_g_mean_mag < 12

# 2. Goal: Back-propagate the Gaia data (J2016.0) to the Hipp-epoch (J1991.25)
# Result: Selected Gaia data + back propagated 6-dimensional vector for all 3e6 objects
# Comment: Saved as ..
# Comment: prop_vector is a 6-dim vector, attempted to save field separately but did not work (see below)
# Comment: Key is that array elements need to be extracted using array_element(..), instead of indexing with []

SELECT source_id, ra, dec, parallax, pmra, pmra_error, pmdec, pmdec_error, phot_g_mean_mag,
	   array_element(a0,1) as ra_prop,
       array_element(a0,2) as dec_prop,
       array_element(a0,3) as parallax_prop,
       array_element(a0,4) as pmra_prop,
       array_element(a0,5) as pmdec_prop,
       array_element(a0,6) as rv_prop
FROM
	(
	SELECT *, EPOCH_PROP(ra, dec, parallax, pmra, pmdec, radial_velocity, 2016.0, 1991.25) as a0
	FROM user_rkievit.gaia_sel12
	) as p



